{
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireBranch": "master"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publishArgs": "--registry=https://registry.npmjs.org",
    "skipChecks": true
  },
  "hooks": {
    "before:init": ["yarn lint", "yarn tsd:test", "yarn test"],
    "after:bump": "yarn build"
  }
}
